# ---- Discord bot (Railway worker) ----
TOKEN=your_discord_bot_token_here
GUILD_IDS=
MAX_BYTES=1000000

# Hosted loaders + /manage require the API backend:
OBF_BACKEND=api
API_URL=https://your-project.vercel.app/api

# ---- API (Vercel) ----
# Public base for the loadstring URLs (defaults to the request host):
PUBLIC_BASE_URL=https://your-project.vercel.app
# Persistent loader storage (Neon serverless Postgres on Vercel).
# The Neon integration sets DATABASE_URL for you; without it the API stores
# loaders in memory and they vanish on redeploy. Use the pooled connection string.
DATABASE_URL=
